# Yemek Gelsin — Caddy ters vekil (00 §2, 14 §1). Otomatik TLS (Let's Encrypt).
# Alan adı .env'deki DOMAIN'den gelir (varsayılan yemekgelsin.net). Yönlendirme:
#   DOMAIN, panel.DOMAIN, admin.DOMAIN  → /api/* API'ye (SSE için tamponsuz), geri kalan web'e
#                                         (panel./admin. kökü web'de proxy.ts ile /panel ve /admin'e yazılır)
#   www.DOMAIN                          → DOMAIN'e kalıcı yönlendirme
#   {slug}.DOMAIN (wildcard)            → web; proxy.ts alt alan adını /s/{slug} vitrinine yazar
#   hooks.DOMAIN/wa/<token>             → API /api/v1/webhooks/wa/<token> (WhatsApp webhook'u; 00 §2)
# Canlı ortamda (00 §12a madde 10) Cloudflare yalnız DNS + proxy'dir (turuncu bulut) ve SSL/TLS modu Full (strict)
# olmalıdır. TÜM sertifikalar DNS-01 ile alınır (acme_dns): wildcard bunu zaten ister, ayrıca kök ve alt alan adlarının
# sertifikası DNS henüz bu sunucuyu göstermeden (canlıya geçişten önce) ve Cloudflare proxy'si arkasında da alınabilir.
# docker/caddy.Dockerfile Cloudflare DNS modülüyle derlenir; CLOUDFLARE_API_TOKEN (.env) yalnız bu bölgede
# "Zone > DNS > Edit + Zone > Zone > Read" yetkili olmalı. Ayrıntı: docs/15-kurulum-ve-isletim.md §3, §14.

{
	email {$ACME_EMAIL:destek@yemekgelsin.net}
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	# Cloudflare proxy'si (turuncu bulut) arkasında gerçek istemci IP'si: yalnız Cloudflare adreslerinden gelen
	# X-Forwarded-For'a güvenilir ve sağdan sola okunur (trusted_proxies_strict: istemcinin kendi yazdığı sahte değer
	# atlanır). Doğrudan bağlanan istemcide başlık yok sayılır, bağlantı adresi kullanılır. API'ye bu değer tek başına
	# iletilir (aşağıda header_up X-Forwarded-For {client_ip}); hız sınırları ve erişim logu (5651) gerçek IP'yi görür.
	# Cloudflare IP aralıkları: https://www.cloudflare.com/ips/ (değişirse burada güncelleyin).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
	# Caddy'nin kendi (çalışma) logları JSON, stdout'a (docker compose logs caddy). HTTP erişim logları aşağıdaki
	# (access_log) parçasıyla her site bloğunda ayrıca açılır; bu global blok erişim logu üretmez.
	log {
		output stdout
		format json
		level INFO
	}
}

# HTTP erişim logları (08 §2.8 satır 10, 5651: trafik bilgisi 1 yıl; 06 §14.2). İki çıktı:
#   - stdout → `docker compose logs caddy` (sorun giderme; Docker 5×20 MB ile sınırlar)
#   - caddy_logs birimi /var/log/caddy/access.log → 100 MB'ta döner, 366 gün saklanır (yasal kayıt)
# Cookie/Authorization başlıkları Caddy tarafından zaten maskelenir. Yoldaki gizli belirteçler (WhatsApp webhook
# belirteci — ortak numaranın /wa/shared/<belirteç> adresi dahil —, müşteri takip belirteci) ve kurye giriş linkindeki
# ?t= kırpılır; IP, zaman, yöntem, durum kalır.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/(?:api/v1/webhooks/wa(?:/shared)?|wa(?:/shared)?|t|api/v1/store/track)/)[^/?#]+|([?&]t=)[^&#]*" "${1}${2}***"
			}
		}
	}
	log access_file {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 1000
			roll_keep_for 8784h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/(?:api/v1/webhooks/wa(?:/shared)?|wa(?:/shared)?|t|api/v1/store/track)/)[^/?#]+|([?&]t=)[^&#]*" "${1}${2}***"
			}
		}
	}
}

# Ortak kurallar: erişim logu, güvenlik başlıkları, API (SSE dahil) ve web.
(site) {
	import access_log

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Yükleme sınırı: menü görselleri 5 MB (14 §6.3) + pay
	request_body {
		max_size 8MB
	}

	# API: /api/v1/* (REST, SSE /api/v1/panel/stream, webhook'lar, /api/v1/uploads).
	# flush_interval -1 → olay akışı anında iletilir (tamponlama yok); sıkıştırma YOK.
	handle /api/* {
		reverse_proxy api:4000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Web (Next.js): sayfalar, storefront, panel, admin, kurye
	handle {
		encode zstd gzip
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

{$DOMAIN:yemekgelsin.net}, panel.{$DOMAIN:yemekgelsin.net}, admin.{$DOMAIN:yemekgelsin.net} {
	import site
}

www.{$DOMAIN:yemekgelsin.net} {
	import access_log
	redir https://{$DOMAIN:yemekgelsin.net}{uri} permanent
}

# WhatsApp webhook alt alan adı (isteğe bağlı; panelde gösterilen adres DOMAIN/api/v1/webhooks/wa/<token>'dır)
hooks.{$DOMAIN:yemekgelsin.net} {
	import access_log
	handle_path /wa/* {
		rewrite * /api/v1/webhooks/wa{path}
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		respond 404
	}
}

# İşletme vitrinleri: {slug}.DOMAIN — tek wildcard sertifika (DNS-01, Cloudflare; global acme_dns)
*.{$DOMAIN:yemekgelsin.net} {
	import site
}
