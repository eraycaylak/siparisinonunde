{
  "name": "siparisinonunde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"pnpm --filter @siparis/api dev\" \"pnpm --filter @siparis/api dev:worker\" \"pnpm --filter @siparis/web dev\"",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:legal": "tsx scripts/check-legal.ts",
    "test:vps": "node --test scripts/vps/env-merge.test.mjs scripts/vps/cloudflare-dns.test.mjs scripts/vps/deploy.test.mjs .github/workflows/deploy-gate.test.mjs",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @siparis/db generate",
    "db:migrate": "pnpm --filter @siparis/db migrate",
    "db:seed": "pnpm --filter @siparis/db seed",
    "db:reset": "pnpm --filter @siparis/db reset"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
