// Yemek Gelsin — Cloudflare dev/demo ortamı (15 §13). Dağıtım: .github/workflows/deploy-dev-cloudflare.yml
// Container imajı depo kökünden derlenir (deploy/cloudflare/Dockerfile). NEXT_PUBLIC_SITE_URL derleme anında gömülür;
// iş akışı SITE_URL'yi (https://yemekgelsin.net) scripts/prepare-config.mjs ile wrangler.generated.jsonc'ye yazar.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siparisinonunde-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  // yemekgelsin.net aynı Cloudflare hesabında (Registrar). Custom Domain: DNS kaydı ve sertifika otomatik; token'da
  // bölge için Zone > Workers Routes > Edit ve Zone > Zone > Read gerekir. www, Worker'da köke 301 ile yönlenir.
  "routes": [
    { "pattern": "yemekgelsin.net", "custom_domain": true },
    { "pattern": "www.yemekgelsin.net", "custom_domain": true }
  ],
  // Yedek adres: API ve webhook istekleri çalışır, sayfa gezinmeleri özel alan adına yönlenir (src/access.ts)
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB bellek, 4 GB disk: PostgreSQL + API + worker + web için yeterli (dev)
      "instance_type": "basic",
      "max_instances": 1,
      "image_vars": {
        "NEXT_PUBLIC_SITE_URL": "https://yemekgelsin.net"
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  // MCP ile oluşturuldu (bölge ENAM); yalnız dev ortamının demo verisinin yedeği
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "siparisinonunde-dev-yedek" }],
  "vars": {
    "APP_BASE_URL": "https://yemekgelsin.net",
    "DEPLOY_ENV": "dev",
    // Veri dönemi: R2 yedek anahtarlarının öneki (e2/db/son.dump …; yalnız rakam). Container açılışta alır ve ömrü boyunca
    // kullanır. Demo verisini sıfırlamak için artırın: yeni container yeni önekte yedek bulamaz, boş veritabanı + seed ile
    // açılır; eski container'ın son yedeği ve eski nesneler kendi öneklerinde kalır (15 §13 "Sıfırlama").
    "DATA_EPOCH": "2"
  },
  "secrets": {
    "required": [
      "DEV_PASSWORD",
      "SESSION_SECRET",
      "TRACKING_SECRET",
      "ENCRYPTION_KEY",
      "WA_VERIFY_TOKEN",
      "PLATFORM_WA_WEBHOOK_TOKEN",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY"
    ]
  }
}
