// Yemek Gelsin — CANLI ORTAM, Cloudflare (00 §12a madde 10; 15 §13). Dağıtım: .github/workflows/deploy-dev-cloudflare.yml
// ("Canlı ortam (Cloudflare)"). Container imajı depo kökünden derlenir (deploy/cloudflare/Dockerfile). Bu dosya ALAN ADI
// kipini tanımlar: https://yemekgelsin.net, gerçek veri, üretim kipi (DEPLOY_ENV=production; src/mode.ts), demo verisi yok.
// İş akışı kipi seçer ve scripts/prepare-config.mjs (config-modes.mjs) ile wrangler.generated.jsonc'yi yazar: yalnız
// isteğe bağlı Türkiye VPS'i canlıdayken (VPS_HOST secret'ı) gizli staging (yalnız workers.dev, routes yok, demo verili,
// STAGING_DATA_EPOCH). İç adlar (Worker siparisinonunde-dev, R2 kovası) değişmez (00 §12a madde 9).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siparisinonunde-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  // yemekgelsin.net aynı Cloudflare hesabında (Registrar). Custom Domain: DNS kaydı ve sertifika otomatik; token'da
  // bölge için Zone > Workers Routes > Edit ve Zone > Zone > Read gerekir. www, Worker'da köke 301 ile yönlenir.
  "routes": [
    { "pattern": "yemekgelsin.net", "custom_domain": true },
    { "pattern": "www.yemekgelsin.net", "custom_domain": true }
  ],
  // Yedek adres: API ve webhook istekleri çalışır, sayfa gezinmeleri özel alan adına yönlenir (src/access.ts)
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB bellek, 4 GB disk: PostgreSQL + API + worker + web için yeterli (pilot yükü; yetmezse standard-1)
      "instance_type": "basic",
      "max_instances": 1,
      "image_vars": {
        "NEXT_PUBLIC_SITE_URL": "https://yemekgelsin.net",
        // "Demo ortamı" uyarısı ve pazarlama sitesindeki demo vitrin bağlantısı: alan adı kipinde kapalı/boş (demo verisi
        // yok); staging'de config-modes.mjs açar
        "NEXT_PUBLIC_DEMO_BANNER": "0",
        "NEXT_PUBLIC_DEMO_STORE_SLUG": "",
        // /demo lead formu açık (kişisel veri aktarımı aydınlatma metinlerinde yazılı; CLAUDE.md kural 7). WhatsApp simülatörü
        // canlı ortamda derlenmez (/dev/whatsapp 404); staging'de config-modes.mjs açar. Destek hattı (WhatsApp) GitHub
        // secret'ı SUPPORT_WHATSAPP'tan (config-modes.mjs)
        "NEXT_PUBLIC_LEAD_FORM": "1",
        "NEXT_PUBLIC_DEV_TOOLS": "0",
        "NEXT_PUBLIC_SUPPORT_WHATSAPP": ""
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  // Canlı veritabanı ve görsel yedekleri (bölge ENAM, Kuzey Amerika doğusu; kişisel veri yurt dışında, KVKK m.9 — 08 §2.11).
  // Container her açılışta son yedeği buradan geri yükler; entrypoint.sh 2 dakikada bir (değişiklik varsa) ve kapanışta yazar.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "siparisinonunde-dev-yedek" }],
  "vars": {
    "APP_BASE_URL": "https://yemekgelsin.net",
    // domain: canlı ortam (yemekgelsin.net; container DEPLOY_ENV=production, 2FA zorunlu, geliştirici araçları kapalı,
    // arama motorlarına açık — src/mode.ts) | staging: config-modes.mjs yazar (gizli, workers.dev, DEPLOY_ENV=dev)
    "DEPLOY_MODE": "domain",
    // Container seed'i: admin = yalnız platform yöneticisi (admin@yemekgelsin.net, parola DEV_PASSWORD) + üretim bayrakları
    // (kayıt açık; yöneticinin bayrak kararlarına dokunulmaz); staging'de demo
    "SEED_MODE": "admin",
    // Veri dönemi: R2 yedek anahtarlarının öneki (e3/db/son.dump …; yalnız rakam). Container açılışta alır ve ömrü boyunca
    // kullanır. Veriyi sıfırlamak için artırın: yeni container yeni önekte yedek bulamaz, boş veritabanı + seed ile açılır;
    // eski container'ın son yedeği ve eski nesneler kendi öneklerinde kalır (15 §13 "Sıfırlama"). "3": demo verisi
    // kaldırıldı (00 §12a madde 10); e2 ve öncesi eski demo verisidir. CANLI VERİ bu dönemdedir: artırmak gerçek veriyi
    // (işletmeler, siparişler) boş veritabanıyla değiştirir; yalnız bilinçli bir sıfırlama kararıyla değiştirin.
    "DATA_EPOCH": "3",
    // Gizli staging'in ayrı veri dönemi (demo verisi alan adı verisine karışmasın); DATA_EPOCH'tan farklı olmalı
    "STAGING_DATA_EPOCH": "901"
  },
  "secrets": {
    "required": [
      "DEV_PASSWORD",
      "SESSION_SECRET",
      "TRACKING_SECRET",
      "ENCRYPTION_KEY",
      "WA_VERIFY_TOKEN",
      "PLATFORM_WA_WEBHOOK_TOKEN",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY"
    ]
  }
}
