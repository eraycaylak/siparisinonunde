# Yemek Gelsin — ÜRETİM ortam değişkenleri (docker-compose.yml). Kopyala: cp docker/env.production.example .env
# Açıklamalar ve gizli anahtar üretme komutları: docs/15-kurulum-ve-isletim.md §4. .env dosyası git'e girmez.
# Canlı ortam (Türkiye VPS) GitHub Actions ile kuruluyorsa bu dosyayı elle doldurmayın: .env'i iş akışı yazar
# (scripts/vps/env-merge.mjs; gizli anahtarlar bir kez üretilir ve korunur, sağlayıcı değerleri GitHub secret'larından
# her dağıtımda yenilenir; 15 §14).

# --- Alan adı ve TLS (Caddy) ---
DOMAIN=yemekgelsin.net
ACME_EMAIL=destek@yemekgelsin.net
# Cloudflare API belirteci (Zone.Zone:Read + Zone.DNS:Edit, yalnız bu bölge) — zorunlu: tüm sertifikalar DNS-01 ile alınır
# (Caddyfile acme_dns; {slug}.DOMAIN wildcard'ı ve Cloudflare proxy'si arkasındaki kök alan adı). Yalnız caddy konteynerine
# verilir; api/worker/migrate ortamında boştur (docker-compose.yml x-api-base). Başka yetkisi olmayan ayrı bir token kullanın.
CLOUDFLARE_API_TOKEN=

# --- PostgreSQL (DATABASE_URL compose'da bunlardan kurulur; parola yalnız harf/rakam: openssl rand -hex 24) ---
POSTGRES_USER=siparis
POSTGRES_PASSWORD=
POSTGRES_DB=siparis

# --- Uygulama (14 §3) ---
# APP_BASE_URL compose'da https://${DOMAIN} olarak verilir; API_PORT=4000, UPLOAD_DIR=/data/uploads sabittir.
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32
TRACKING_SECRET=
# 32 bayt base64 (WhatsApp/SMS API anahtarlarını şifreler; KAYBEDİLİRSE kayıtlı anahtarlar çözülemez):
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- WhatsApp (00 §12a madde 8: ortak numara 360dialog üzerinden; docs/15 §6.2) ---
# İsteğe bağlı VPS iş akışı bunları GitHub secret'larından yazar: D360_API_KEY + WA_PHONE (360dialog) ya da META_* (Meta doğrudan).
# İşletme hesaplarının sağlayıcısı panelde seçilir; bu yalnız yeni hesap varsayılanıdır: mock | cloud | d360
WA_DEFAULT_PROVIDER=d360
# cloud (Meta Cloud API) webhook imzası (X-Hub-Signature-256) — 360dialog imza göndermez, d360'ta boş (teyit edilmeli)
WA_APP_SECRET=
# Webhook GET doğrulaması (hub.verify_token; Meta doğrudan yolda kullanılır) — üretimde her durumda zorunlu: openssl rand -hex 16
WA_VERIFY_TOKEN=
# Platform numarası = ortak numara (müşteri siparişleri + işletme sahibine alarm şablonları): mock | d360 | cloud
PLATFORM_WA_PROVIDER=d360
# d360: 360dialog Hub > numara > API key (docs/15 §6.2 A.4); cloud: Meta kalıcı System User token'ı
PLATFORM_WA_API_KEY=
# cloud için platform numarasının phone_number_id'si (d360'ta boş)
PLATFORM_WA_PHONE_NUMBER_ID=
# cloud, isteğe bağlı: WhatsApp Business Account ID (Meta > WhatsApp > API Setup). Admin > WhatsApp > WhatsApp kurulumu'ndaki
# "Webhook aboneliğini aç" ve "Şablonları Meta'ya gönder" adımları için (15 §6.2b); gönderim için gerekmez; d360'ta boş
PLATFORM_WA_WABA_ID=
# Ortak numara (00 §12a madde 8): işletmeler varsayılan olarak bu platform numarasından sipariş alır (dükkan kodu + QR).
# Uyarı şablonları ve müşteri siparişleri AYNI numarayı kullanır. E.164 gösterim (QR ve wa.me bağlantıları) — zorunlu:
PLATFORM_WA_DISPLAY_PHONE=
# Ortak numara webhook belirteci — zorunlu (openssl rand -hex 24). Adres: https://DOMAIN/api/v1/webhooks/wa/shared/<belirteç>
# (360dialog: admin > WhatsApp > WhatsApp kurulumu > "Webhook'u 360dialog'a kaydet"; Meta doğrudan: "Göster" → Meta'ya yapıştır)
PLATFORM_WA_WEBHOOK_TOKEN=

# --- SMS (OTP ve kritik durum SMS'leri): mock | netgsm ---
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Onaylı alfanümerik başlık (≤ 11 karakter, ör. YEMEKGELSIN — teyit edilmeli)
NETGSM_HEADER=

# --- Web Push (yeni sipariş bildirimi, 00 §10 alarm t=0; docs/15 §4) ---
# Boşsa push kapalıdır; API/worker açılır ama logda uyarı yazar. Anahtar çifti (bir kez; değiştirirseniz tüm cihazlar
# "Siparişleri almaya başla"da yeniden abone olur):
#   docker compose run --rm --no-deps api npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İtme servislerinin (Google, Apple, Mozilla) sorun olursa yazacağı adres: mailto:… ya da https://…
VAPID_SUBJECT=mailto:destek@yemekgelsin.net

# --- Diğer ---
# Faz 2 (AI); boşsa kapalı
ANTHROPIC_API_KEY=
# ÜRETİMDE 0 (geliştirici simülatörü /dev/whatsapp ve /api/v1/dev/* kapalı). Değişince: docker compose build web
DEV_TOOLS=0
LOG_LEVEL=info
# Canlı ortamda demo işletme yok (00 §12a madde 10): boş bırakın ("Demo menüyü aç" kartı gizlenir)
DEMO_STORE_SLUG=
# "Demo ortamı" uyarısı: canlı ortamda 0
DEMO_BANNER=0
# Platform destek hattı (WhatsApp), rakamlarla: ör. 905321234567. Giriş ekranındaki "Parolamı unuttum" işletme
# sahibine bu numarayı gösterir (boşsa iletişim formunu). Değişince: docker compose build web
SUPPORT_WHATSAPP=

# --- Yedekleme (scripts/backup.sh) ---
# İkinci konum (başka bir Türkiye lokasyonu), rclone uzak adı: ör. yedek-ankara:siparis-yedek
BACKUP_REMOTE=
RETENTION_DAYS=14
# Dış izleme "push" adresi (Uptime Kuma vb.): her başarılı yedekten sonra çağrılır; 26 sa gelmezse alarm (docs/15 §8)
BACKUP_PING_URL=
