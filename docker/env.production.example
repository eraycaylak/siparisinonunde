# Siparişin Önünde — ÜRETİM ortam değişkenleri (docker-compose.yml). Kopyala: cp docker/env.production.example .env
# Açıklamalar ve gizli anahtar üretme komutları: docs/15-kurulum-ve-isletim.md §4. .env dosyası git'e girmez.

# --- Alan adı ve TLS (Caddy) ---
DOMAIN=siparisinonunde.com
ACME_EMAIL=ops@siparisinonunde.com
# Cloudflare API belirteci (Zone.Zone:Read + Zone.DNS:Edit, yalnız bu bölge) — {slug}.DOMAIN wildcard sertifikası için
CLOUDFLARE_API_TOKEN=

# --- PostgreSQL (DATABASE_URL compose'da bunlardan kurulur; parola yalnız harf/rakam: openssl rand -hex 24) ---
POSTGRES_USER=siparis
POSTGRES_PASSWORD=
POSTGRES_DB=siparis

# --- Uygulama (14 §3) ---
# APP_BASE_URL compose'da https://${DOMAIN} olarak verilir; API_PORT=4000, UPLOAD_DIR=/data/uploads sabittir.
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32
TRACKING_SECRET=
# 32 bayt base64 (WhatsApp/SMS API anahtarlarını şifreler; KAYBEDİLİRSE kayıtlı anahtarlar çözülemez):
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- WhatsApp (00 §12a: aracı 360dialog) ---
# İşletme hesaplarının sağlayıcısı panelde seçilir; bu yalnız yeni hesap varsayılanıdır: mock | cloud | d360
WA_DEFAULT_PROVIDER=d360
# cloud (Meta Cloud API) webhook imzası (X-Hub-Signature-256) — 360dialog'da boş bırakılabilir (teyit edilmeli)
WA_APP_SECRET=
# cloud: webhook GET doğrulaması (hub.verify_token) — rastgele: openssl rand -hex 16
WA_VERIFY_TOKEN=
# Platform uyarı numarası (işletme sahibine alarm şablonları): mock | cloud | d360
PLATFORM_WA_PROVIDER=d360
PLATFORM_WA_API_KEY=
# cloud için platform numarasının phone_number_id'si (d360'ta boş)
PLATFORM_WA_PHONE_NUMBER_ID=

# --- SMS (OTP ve kritik durum SMS'leri): mock | netgsm ---
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Onaylı alfanümerik başlık (≤ 11 karakter, ör. SIPARISNDE — teyit edilmeli)
NETGSM_HEADER=

# --- Web Push (yeni sipariş bildirimi, 00 §10 alarm t=0; docs/15 §4) ---
# Boşsa push kapalıdır; API/worker açılır ama logda uyarı yazar. Anahtar çifti (bir kez; değiştirirseniz tüm cihazlar
# "Siparişleri almaya başla"da yeniden abone olur):
#   docker compose run --rm --no-deps api npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İtme servislerinin (Google, Apple, Mozilla) sorun olursa yazacağı adres: mailto:… ya da https://…
VAPID_SUBJECT=mailto:ops@siparisinonunde.com

# --- Diğer ---
# Faz 2 (AI); boşsa kapalı
ANTHROPIC_API_KEY=
# ÜRETİMDE 0 (geliştirici simülatörü /dev/whatsapp ve /api/v1/dev/* kapalı). Değişince: docker compose build web
DEV_TOOLS=0
LOG_LEVEL=info
DEMO_STORE_SLUG=bozok-pide
# Platform destek hattı (WhatsApp), rakamlarla: ör. 905321234567. Giriş ekranındaki "Parolamı unuttum" işletme
# sahibine bu numarayı gösterir (boşsa iletişim formunu). Değişince: docker compose build web
SUPPORT_WHATSAPP=

# --- Yedekleme (scripts/backup.sh) ---
# İkinci konum (başka bir Türkiye lokasyonu), rclone uzak adı: ör. yedek-ankara:siparis-yedek
BACKUP_REMOTE=
RETENTION_DAYS=14
# Dış izleme "push" adresi (Uptime Kuma vb.): her başarılı yedekten sonra çağrılır; 26 sa gelmezse alarm (docs/15 §8)
BACKUP_PING_URL=
