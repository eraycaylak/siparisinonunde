# Siparişin Önünde — ortam değişkenleri (14 §3). Kopyala: cp .env.example .env
DATABASE_URL=postgres://siparis:siparis@localhost:5432/siparis_dev
TEST_DATABASE_URL=postgres://siparis:siparis@localhost:5432/siparis_test
# Web kök adresi (linkler, takip, storefront)
APP_BASE_URL=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
SESSION_SECRET=dev-only-change-me-32chars-minimum
TRACKING_SECRET=dev-only-tracking-secret
# WhatsApp/SMS API anahtarlarını şifreler (AES-256-GCM). 32 bayt base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# mock | cloud | d360
WA_DEFAULT_PROVIDER=mock
# cloud: X-Hub-Signature-256 doğrulaması
WA_APP_SECRET=
# cloud: GET doğrulama
WA_VERIFY_TOKEN=dev-verify
# Platform uyarı numarası
PLATFORM_WA_PROVIDER=mock
PLATFORM_WA_API_KEY=
# cloud: platform numarasının phone_number_id'si (d360'ta boş)
PLATFORM_WA_PHONE_NUMBER_ID=
# Ortak numara (00 §12a madde 8): tüm işletmelerin varsayılan WhatsApp numarası = platform numarası (uyarılar da buradan).
# E.164 gösterim (QR, wa.me). Boşsa mock'ta +905550000000
PLATFORM_WA_DISPLAY_PHONE=+905550000000
# Ortak numara webhook'u: /api/v1/webhooks/wa/shared/<belirteç> (boşsa kapalı; simülatör webhook'suz çalışır)
PLATFORM_WA_WEBHOOK_TOKEN=dev-shared-webhook-token
# mock | netgsm
SMS_PROVIDER=mock
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
UPLOAD_DIR=./uploads
# Faz 2 (AI), boşsa kapalı
ANTHROPIC_API_KEY=
# Web Push: yeni sipariş bildirimi (00 §10 alarm t=0). Üçü de boşsa push kapalıdır (panel sesi ve diğer alarmlar çalışır).
# Anahtar çifti: pnpm --filter @siparis/api exec web-push generate-vapid-keys (bir kez üretin; değişirse cihazlar yeniden abone olur)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İtme servislerinin ulaşacağı iletişim adresi: mailto:… ya da https://…
VAPID_SUBJECT=
# /dev/whatsapp simülatörü ve /api/v1/dev/* (üretimde 0)
DEV_TOOLS=1
# production | dev — dev: Cloudflare demo ortamı; üretim derlemesinde DEV_TOOLS'u yalnız tüm sağlayıcılar mock iken açar (15 §13)
DEPLOY_ENV=production
# Platform yöneticilerine iki adımlı doğrulama (TOTP) zorunlu mu (1/0). Boşsa üretimde 1, diğer ortamlarda 0.
# Zorunluyken TOTP'si kurulmamış yönetici yalnız /admin/guvenlik ekranını kullanabilir (00 §12a madde 7).
ADMIN_TOTP_REQUIRED=
