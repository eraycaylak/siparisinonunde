{
  "name": "@siparis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@siparis/core": "workspace:*",
    "@siparis/db": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^4.1.0"
  },
  "devDependencies": { "@types/qrcode": "^1.5.5", "pino-pretty": "^13.0.0" }
}
